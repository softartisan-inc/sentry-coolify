# ---------------------------------------------------------------------------
# Sentry self-hosted — variables d'environnement : le STRICT MINIMUM.
#
# Sous Coolify : coller ce contenu dans l'onglet "Environment Variables" de la
# ressource. Les variables SERVICE_* sont generees par Coolify a la creation
# de la ressource — ne les renseignez pas a la main.
#
# Toutes les autres variables (retention, plafonds memoire, parallelisme,
# SMTP externe, tags d'images...) ont un defaut sain dans le compose et sont
# documentees dans le README, section « Variables d'environnement » : ajoutez
# uniquement celles que vous voulez changer.
# ---------------------------------------------------------------------------

# --- OBLIGATOIRE au premier deploiement -------------------------------------
# Compte administrateur cree au premier demarrage. Sans lui, aucun compte
# n'existe et l'inscription est fermee. Mot de passe :
# SERVICE_PASSWORD_SENTRYADMIN, genere par Coolify.
SENTRY_ADMIN_EMAIL=admin@example.com

# Domaine expediteur des e-mails (relais exim interne).
SENTRY_MAIL_HOST=example.com

# --- Genere par Coolify (ne pas remplir sous Coolify) -----------------------
# Hors Coolify uniquement : SERVICE_PASSWORD_64_SENTRYSECRET est OBLIGATOIRE
# (64 caracteres aleatoires — cle de signature des sessions et du CSRF) et
# SERVICE_URL_SENTRY est l'URL publique complete (https://sentry.example.com).
SERVICE_PASSWORD_64_SENTRYSECRET=
SERVICE_PASSWORD_SENTRYADMIN=
SERVICE_URL_SENTRY=
