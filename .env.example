# ---------------------------------------------------------------------------
# Sentry self-hosted — variables d'environnement
#
# Sous Coolify : coller ce contenu dans l'onglet "Environment Variables" de la
# ressource. Les variables prefixees SERVICE_ sont generees par Coolify, ne les
# renseignez pas a la main.
#
# En local / hors Coolify : copier vers .env et renseigner les trois valeurs
# marquees OBLIGATOIRE.
# ---------------------------------------------------------------------------

# --- Genere par Coolify (ne pas remplir sous Coolify) ----------------------
# Cle de signature des sessions et des tokens CSRF. La changer invalide toutes
# les sessions ouvertes. OBLIGATOIRE hors Coolify : 50 caracteres aleatoires.
SERVICE_PASSWORD_SENTRYSECRET=
# Mot de passe du compte admin cree au premier boot.
SERVICE_PASSWORD_SENTRYADMIN=
# URL publique, ex. https://sentry.example.com — Coolify la derive du domaine.
SERVICE_FQDN_SENTRY=

# --- Images (epinglees, publiees par le workflow GitHub Actions) -----------
SENTRY_SA_IMAGE=ghcr.io/softartisan-inc/sentry-sa:26.8.0
SENTRY_CLEANUP_SA_IMAGE=ghcr.io/softartisan-inc/sentry-cleanup-sa:26.8.0
SNUBA_SA_IMAGE=ghcr.io/softartisan-inc/snuba-sa:26.8.0
RELAY_SA_IMAGE=ghcr.io/softartisan-inc/relay-sa:26.8.0
SYMBOLICATOR_SA_IMAGE=ghcr.io/softartisan-inc/symbolicator-sa:26.8.0
TASKBROKER_SA_IMAGE=ghcr.io/softartisan-inc/taskbroker-sa:26.8.0
CLICKHOUSE_SA_IMAGE=ghcr.io/softartisan-inc/clickhouse-sa:26.8.0
NGINX_SA_IMAGE=ghcr.io/softartisan-inc/nginx-sa:26.8.0
VALKEY_SA_IMAGE=ghcr.io/softartisan-inc/valkey-sa:26.8.0

# --- Compte administrateur initial ----------------------------------------
# OBLIGATOIRE au premier deploiement, sinon aucun compte n'existe et
# l'inscription est fermee.
SENTRY_ADMIN_EMAIL=admin@example.com

# --- Retention -------------------------------------------------------------
# Poste d'economie le plus efficace apres le profil errors-only. 30 jours
# divisent par 3 le volume ClickHouse par rapport au defaut upstream (90).
SENTRY_EVENT_RETENTION_DAYS=30
# Duree de vie des messages dans Kafka. Kafka n'est qu'un tampon ici.
KAFKA_LOG_RETENTION_HOURS=3

# --- Plafonds memoire ------------------------------------------------------
# Toujours regler KAFKA_HEAP_OPTS avec KAFKA_MEM_LIMIT : la JVM ignore la
# limite du conteneur et prend 25 % de la RAM de l'hote sans plafond explicite.
KAFKA_MEM_LIMIT=1536M
KAFKA_HEAP_OPTS=-Xmx768m -Xms768m
CLICKHOUSE_MEM_LIMIT=2G
CLICKHOUSE_MEMORY_RATIO=0.6
REDIS_MAXMEMORY=384mb

# --- Parallelisme ----------------------------------------------------------
# Chaque worker uwsgi coute ~300 Mo, chaque unite de taskworker ~300 Mo aussi.
SENTRY_WEB_WORKERS=2
SENTRY_WEB_THREADS=4
SENTRY_TASKWORKER_CONCURRENCY=2
SNUBA_UWSGI_PROCESSES=2
SNUBA_UWSGI_THREADS=2

# --- Acces -----------------------------------------------------------------
# Port publie sur l'hote pour un acces direct sans Traefik (dev, tunnel SSH).
# Sous Coolify, laisser la loopback : le domaine se configure dans l'UI sur le
# service nginx, pas ici.
SENTRY_BIND=127.0.0.1:9000

SENTRY_ALLOW_REGISTRATION=false
# Origines supplementaires autorisees pour le CSRF, separees par des virgules.
SENTRY_CSRF_TRUSTED_ORIGINS=

# --- Email -----------------------------------------------------------------
# Domaine expediteur, utilise par le conteneur smtp interne (exim).
SENTRY_MAIL_HOST=example.com
#
# Relais externe recommande en production (delivrabilite). Renseigner
# SENTRY_SMTP_HOST bascule Sentry dessus et rend le conteneur smtp inutile.
SENTRY_SMTP_HOST=
SENTRY_SMTP_PORT=587
SENTRY_SMTP_USERNAME=
SENTRY_SMTP_PASSWORD=
SENTRY_SMTP_FROM=sentry@example.com
SENTRY_SMTP_USE_TLS=true

# --- Stockage objet interne (SeaweedFS) ------------------------------------
SENTRY_S3_ACCESS_KEY=sentry
SENTRY_S3_SECRET_KEY=sentry

# --- Divers ----------------------------------------------------------------
SENTRY_MAX_EXTERNAL_SOURCEMAP_SIZE=1M
# A augmenter si des consumers sont expulses du groupe Kafka sous charge.
SENTRY_KAFKA_MAX_POLL_INTERVAL_MS=300000
